type Query {
    studentById(id: ID!): StudentEntity
    allStudent: [StudentEntity]
}

type StudentEntity {
    id: ID!
    rollNo: String!
    firstName: String!
    lastName : String!
    email : String!
    address: Address

}

type Address {
    id: ID!
    street: String!
    city: String!
    state: String!
}
